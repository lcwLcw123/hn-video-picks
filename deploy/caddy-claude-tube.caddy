
# --- claude-tube (HN 片单) — added 2026-11-12, static site, no backend ---
claude.star-flow-ai.com {
	root * /srv/claude-tube/current
	encode zstd gzip
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		Cache-Control "no-cache"
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com"
	}
	file_server
}
